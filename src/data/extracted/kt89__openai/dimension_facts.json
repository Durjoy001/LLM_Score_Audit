    {
      "text": "NetWatcher is a creative application designed to provide surveillance over the Internet on specified computer and tablet devices.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt89__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "NetWatcher monitors 50 devices, allowing remote monitoring of the surrounding environment if a video camera is attached.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt89__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "NetWatcher originally emerged into the market in 2003 via NetGuarder and holds copyrights authorized by the National Copyright Administration of the People's Republic of China.",
      "dimensions": [
        "objectives",
        "strategy",
        "innovation",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
