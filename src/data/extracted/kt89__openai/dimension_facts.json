        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt89__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "NetWatcher serves as a powerful deterrent force for kids' better behaviors.",
