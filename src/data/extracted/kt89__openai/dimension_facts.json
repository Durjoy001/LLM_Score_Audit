        "objectives",
        "feasibility"
      ],
      "type": "milestone",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt89__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Parents can use NetWatcher to observe and control children's computer usage and internet surfing in a close and secret manner.",
