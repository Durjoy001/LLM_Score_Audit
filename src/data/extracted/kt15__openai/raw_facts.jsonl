{"text": "Pronti is a Canadian startup that started in 2021.", "dimensions": ["team"], "type": "other", "primary_dimension": "team", "meta": {"suspect_numeric": false, "proposal_id": "kt15__openai", "chunk_index": 1, "char_start": 1400, "char_end": 3200}}
