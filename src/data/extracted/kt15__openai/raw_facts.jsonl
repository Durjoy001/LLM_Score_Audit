{"text": "On January 3rd, 2022, one of Pronti's TikTok videos went viral.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"suspect_numeric": false, "proposal_id": "kt15__openai", "chunk_index": 1, "char_start": 1400, "char_end": 3200}}
