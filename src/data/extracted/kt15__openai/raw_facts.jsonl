{"text": "Pronti is an outfit maker that aims to aid users in getting ready faster and buying smarter.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt15__openai", "chunk_index": 2, "char_start": 2800, "char_end": 4600}}
