{"text": "Mila Banerjee is the creator of Pronti - Outfit Maker.", "dimensions": ["team"], "type": "team_member", "primary_dimension": "team", "meta": {"proposal_id": "kt15__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
