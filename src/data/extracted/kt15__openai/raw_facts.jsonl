{"text": "The project received CA$ 5,147 from 50 backers.", "dimensions": ["strategy", "feasibility"], "type": "funding_source", "primary_dimension": "strategy", "meta": {"suspect_numeric": false, "proposal_id": "kt15__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "The funding period for the project was from February 10, 2022, to February 27, 2022.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"suspect_numeric": false, "proposal_id": "kt15__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
