    },
    {
      "text": "The creator of Rewind, Jonathan Stevanka, started building the app while studying Mobile Applications development.",
      "dimensions": [
        "team"
      ],
      "type": "team_member",
      "primary_dimension": "team",
      "meta": {
        "proposal_id": "kt47__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Jonathan Stevanka has a tech background and has closely followed the actions of major social media companies.",
      "dimensions": [
        "team"
      ],
      "type": "team_member",
      "primary_dimension": "team",
      "meta": {
        "proposal_id": "kt47__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Jonathan Stevanka is associated with the Rewind app project.",
