        "char_end": 4600
      }
    },
    {
      "text": "Rewind is a social media app built by Jonathan Stevanka over the course of three years.",
      "dimensions": [
        "team",
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "team",
      "meta": {
        "proposal_id": "kt47__openai",
        "chunk_index": 3,
        "char_start": 4200,
        "char_end": 6000
      }
    },
    {
      "text": "Jonathan Stevanka is open to contacting investors for the Rewind app.",
