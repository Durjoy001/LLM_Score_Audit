        "proposal_id": "km14__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Users can offset between 0% to 100% of their CO2 emissions through the app.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "km14__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The app integrates payments to carbon offset providers such as bullfrogpower.com and carbonfund.org.",
