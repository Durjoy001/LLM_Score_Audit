        "proposal_id": "km14__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The app forecasts CO2 emissions based on housing, consumption habits, mode of transportation, and trip distances.",
      "dimensions": [
        "objectives",
        "strategy",
        "innovation",
        "feasibility"
      ],
      "type": "product",
      "primary_dimension": "objectives",
      "meta": {
