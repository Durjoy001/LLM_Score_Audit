        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The NoCO2 mobile app tracks changes in the smartphone's GPS coordinates to question users about their travel habits after each trip.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "km14__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Users of the NoCO2 app can offset some or all of their CO2 emissions through integrated payments to carbon offset providers like bullfrogpower.com or carbonfund.org.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "km14__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Third parties can reward users for low CO2 emissions by matching their contributions to offset providers or green mutual funds.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
