        "proposal_id": "km14__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "The platform allows third parties to upload data on CO2 emissions from vehicles, houses, or products throughout their life cycle.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "km14__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "The goal of the NoCO2 project is to encourage people to change their habits to keep the planet as their home forever.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "km14__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "The NoCO2 mobile app aims to help users easily offset their carbon footprint.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
