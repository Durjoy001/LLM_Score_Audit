  "objectives": [
    {
      "text": "The NoCO2 mobile app tracks a person's CO2 emissions and allows users to offset them with integrated payments to carbon offset providers.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
