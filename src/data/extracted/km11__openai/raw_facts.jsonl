{"text": "Jonathan Joanisse has 13 years of experience making software.", "dimensions": ["team"], "type": "team_member", "primary_dimension": "team", "meta": {"suspect_numeric": false, "proposal_id": "km11__openai", "chunk_index": 2, "char_start": 2800, "char_end": 4600}}
