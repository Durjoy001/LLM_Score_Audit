{"text": "Players can customize their cars by choosing the specifications.", "dimensions": ["innovation"], "type": "other", "primary_dimension": "innovation", "meta": {"proposal_id": "km11__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "The project was created by Jonathan Joanisse.", "dimensions": ["team"], "type": "team_member", "primary_dimension": "team", "meta": {"proposal_id": "km11__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "The project is based in Montreal, Canada.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"proposal_id": "km11__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "Users can create their own racing track in the game and share it to compete for a place on the leaderboard.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "km11__openai", "chunk_index": 1, "char_start": 1400, "char_end": 3200}}
