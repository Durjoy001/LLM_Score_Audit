{"text": "HyberX only activates on demand and does not record in the background.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"proposal_id": "kt70__openai", "chunk_index": 3, "char_start": 4200, "char_end": 6000}}
