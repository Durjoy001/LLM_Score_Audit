{"text": "Scaling real-time AI is expensive and costs significantly more than running a standard chatbot.", "dimensions": ["feasibility"], "type": "risk", "primary_dimension": "feasibility", "meta": {"proposal_id": "kt70__openai", "chunk_index": 3, "char_start": 4200, "char_end": 6000}}
