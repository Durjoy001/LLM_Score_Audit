  "objectives": [
    {
      "text": "SimpleCompliance is a project aimed at protecting individuals from workplace violence, harassment, and danger.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt81__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding goal for SimpleCompliance was $3,530.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt81__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding period for SimpleCompliance was from September 28, 2016, to October 28, 2016.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt81__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The project was unsuccessful in reaching its funding goal by the deadline of October 28, 2016.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt81__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The software acts as an independent third-party ombudsman to ensure a safe workplace and protect individuals from retaliation for reporting incidents.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt81__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "The risk assessment will be offered as part of the overall package once it is validated at an academic level.",
      "dimensions": [
        "objectives"
      ],
      "type": "risk",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt81__openai",
        "chunk_index": 2,
        "char_start": 2800,
        "char_end": 4600
      }
    },
    {
      "text": "The service is being provided as part of a Kickstarter campaign to help individuals know their rights and access the software.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt81__openai",
