{"text": "yogagym is an online yoga service that allows users to access yoga classes anytime, anywhere.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt104__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
