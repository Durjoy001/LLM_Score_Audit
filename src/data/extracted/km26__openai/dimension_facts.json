  "objectives": [
    {
      "text": "The game 'Lets get physical game math science school technology' aims to help secondary students learn math and physics in a fun and interactive way.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
