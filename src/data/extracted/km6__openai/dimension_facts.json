  "objectives": [
    {
      "text": "Incoherence is a single-player, story-driven FPS that blends elements of survival, horror, comedy, and retro-futurism.",
      "dimensions": [
        "objectives",
        "innovation"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
