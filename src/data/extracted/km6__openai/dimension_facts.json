      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "km6__openai",
        "chunk_index": 3,
        "char_start": 4200,
        "char_end": 6000
      }
    },
    {
      "text": "Incoherence will initially be available in both English and French.",
