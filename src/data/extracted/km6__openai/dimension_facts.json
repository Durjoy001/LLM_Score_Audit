        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "km6__openai",
        "chunk_index": 2,
        "char_start": 2800,
        "char_end": 4600
      }
    },
    {
      "text": "Players can overcome challenges by repairing and hacking robots and security systems.",
