        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Players in Incoherence will explore the world, scour for hidden items, and craft useful resources.",
      "dimensions": [
        "objectives",
        "innovation"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "km6__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Players can gain experience through their actions and unlock skills and weapon upgrades.",
      "dimensions": [
        "objectives",
        "innovation"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "km6__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Players can explore computer systems and find notes that piece together the game's narrative.",
