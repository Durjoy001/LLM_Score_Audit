        "objectives"
      ],
      "type": "risk",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "km6__openai",
        "chunk_index": 2,
        "char_start": 2800,
        "char_end": 4600
      }
    },
    {
