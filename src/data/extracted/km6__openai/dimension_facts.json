        "objectives",
        "feasibility"
      ],
      "type": "milestone",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "km6__openai",
        "chunk_index": 4,
        "char_start": 5600,
        "char_end": 7400
      }
    },
    {
