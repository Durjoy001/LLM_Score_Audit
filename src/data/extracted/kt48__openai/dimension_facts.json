  "objectives": [
    {
      "text": "Colorkeys is a project aimed at helping kids learn piano and read music using a color-based method.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt48__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The teacher wanted to pass on his love of piano and music to his students.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt48__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Colorkeys was invented to quickly teach full classes of students how to play piano and read music in a fun and engaging way.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt48__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The project had a funding goal of US$ 50,000.",
