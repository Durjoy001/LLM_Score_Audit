        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding period for the project was from December 14, 2011, to January 18, 2012.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
