        "char_end": 1800
      }
    },
    {
      "text": "The social network is intended to develop a worldwide following.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt28__openai",
