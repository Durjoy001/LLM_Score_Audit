        "char_end": 1800
      }
    },
    {
      "text": "ThaBIT is a versatile 3D environment written in C++ that serves as a user interface wrapper.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
