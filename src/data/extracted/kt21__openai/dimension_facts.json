        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "ThaBIT allows users to interact with their computer in a more natural way.",
      "dimensions": [
        "objectives",
        "strategy",
        "innovation",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt21__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The primary goals of ThaBIT include Internet Browsing, File System Browsing, and interaction with network devices.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt21__openai",
