  "innovation": [
    {
      "text": "ThaBIT is a versatile 3D environment written in C++ that primarily serves as a user interface wrapper.",
      "dimensions": [
        "objectives",
        "strategy",
        "innovation",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
