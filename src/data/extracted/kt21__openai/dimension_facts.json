        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding goal for ThaBIT was $14,122.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
