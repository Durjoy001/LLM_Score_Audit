{
  "team": [
    {
      "text": "The project team behind Refutal is frustrated with current social media and technology.",
      "dimensions": [
        "team"
      ],
      "type": "other",
      "primary_dimension": "team",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The project team believes that companies like Facebook, Twitter, and Discord have changed the rules for discussion.",
      "dimensions": [
        "team"
      ],
      "type": "other",
      "primary_dimension": "team",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    }
  ],
  "objectives": [
    {
      "text": "Refutal is a free political debate and discussion platform.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Users can participate in debates for free and run their own basic guild of up to 30 members.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Users can upgrade their guild's member base or access additional features for a low monthly rate.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Refutal seeks to change the paradigm of free speech in political debate.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding goal for Refutal was US$ 2,000.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The project was unsuccessful in reaching its funding goal by November 15, 2019.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding period for Refutal was from October 16, 2019, to November 15, 2019.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "suspect_numeric": false,
        "proposal_id": "kt31__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Refutal seeks to change the paradigm of free speech by offering a platform for political debate.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Refutal aims to provide a platform for everyone to express their opinions, regardless of how controversial they may be.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Refutal has set up a website and is working on creating a beta version of the client by the end of December of this year.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "The beta version of the client will include features such as political profiling and custom AI-moderation bots.",
      "dimensions": [
        "objectives",
        "strategy",
        "innovation",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Refutal offers a server plan as a reward equal to the amount pledged on Kickstarter.",
