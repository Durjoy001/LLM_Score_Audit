        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt31__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "Refutal hopes to offer a sleek, intuitive, and modern design for its client.",
