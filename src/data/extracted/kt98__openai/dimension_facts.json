      "meta": {
        "proposal_id": "kt98__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "25% of funeral homes are now owned and controlled by private equity and conglomerates.",
