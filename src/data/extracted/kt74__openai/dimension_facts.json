  "objectives": [
    {
      "text": "The project aims to develop an app to track and post prayer walks online.",
      "dimensions": [
        "objectives",
        "strategy"
      ],
      "type": "pipeline",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt74__openai",
