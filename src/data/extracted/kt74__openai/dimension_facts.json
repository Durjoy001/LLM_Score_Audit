        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding period for the project was from January 14, 2016, to February 21, 2016.",
      "dimensions": [
        "objectives",
        "strategy",
        "feasibility"
      ],
      "type": "market",
      "primary_dimension": "objectives",
