{"text": "On a post, users are presented with a full screen video that scales to the size of their device.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 3, "char_start": 4200, "char_end": 6000}}
