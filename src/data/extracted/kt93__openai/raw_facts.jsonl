{"text": "InSite allows users to share posts to other social media platforms or through text and email.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 4, "char_start": 5600, "char_end": 7400}}
