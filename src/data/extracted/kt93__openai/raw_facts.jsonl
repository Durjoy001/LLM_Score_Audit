{"text": "Users can navigate to the location of an event to verify its truthfulness.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 2, "char_start": 2800, "char_end": 4600}}
{"text": "InSite categorizes videos into two sections: Happening Near Me and Trending Worldwide.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"proposal_id": "kt93__openai", "chunk_index": 2, "char_start": 2800, "char_end": 4600}}
{"text": "The Happening Near Me tab shows the closest trending posts to the user.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 2, "char_start": 2800, "char_end": 4600}}
{"text": "The Trending Worldwide tab allows users to scroll through videos sorted by global trends.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 2, "char_start": 2800, "char_end": 4600}}
{"text": "Users can navigate to the location of an event and verify its truthfulness.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 3, "char_start": 4200, "char_end": 6000}}
{"text": "Users can navigate between videos categorized into two sections: Happening Near Me and Trending Worldwide.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 3, "char_start": 4200, "char_end": 6000}}
