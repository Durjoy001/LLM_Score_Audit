{"text": "UpVote and DownVote buttons allow users to add or remove from the post's reputability based on the factual validity of the story.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 3, "char_start": 4200, "char_end": 6000}}
