{"text": "InSite has a built-in cryptocurrency reward system where users are paid to verify, interact with, and post information.", "dimensions": ["objectives", "strategy", "feasibility"], "type": "market", "primary_dimension": "objectives", "meta": {"proposal_id": "kt93__openai", "chunk_index": 5, "char_start": 7000, "char_end": 8800}}
