{"text": "Eudora was originally written by Steve Dorner in 1988.", "dimensions": ["innovation"], "type": "other", "primary_dimension": "innovation", "meta": {"suspect_numeric": false, "proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "Eudora was named in honor of American author Eudora Welty.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "Eudora was bought out by Qualcomm in 1991.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"suspect_numeric": false, "proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "Qualcomm discontinued Eudora in 2006.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"suspect_numeric": false, "proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "Eudora OSE was introduced as a replacement for Eudora but was not well received.", "dimensions": ["feasibility"], "type": "other", "primary_dimension": "feasibility", "meta": {"proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "The code for Eudora was open-sourced and given to the Computer History Museum.", "dimensions": ["innovation"], "type": "other", "primary_dimension": "innovation", "meta": {"proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
{"text": "The Hermes project aims to update Eudora to comply with today's standards.", "dimensions": ["objectives"], "type": "other", "primary_dimension": "objectives", "meta": {"proposal_id": "kt13__openai", "chunk_index": 0, "char_start": 0, "char_end": 1800}}
