      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt103__openai",
        "chunk_index": 1,
        "char_start": 1400,
        "char_end": 3200
      }
    },
    {
      "text": "The funding will support the addition of more currencies and real-time currency look-up features.",
