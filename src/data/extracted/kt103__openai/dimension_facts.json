  "objectives": [
    {
      "text": "The Multi-currency rewards generator aims to help creators raise more funds by adding approximate amounts in other currencies to their rewards.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt103__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The project was created to address the inconvenience for backers who need to convert currencies.",
      "dimensions": [
        "objectives"
      ],
      "type": "mitigation",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt103__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding for the project was canceled by the project creator on May 12, 2016.",
