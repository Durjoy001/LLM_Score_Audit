        "proposal_id": "kt55__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "Early supporters of CastAI will receive exclusive access and priority updates.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt55__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "CastAI is designed to save actors hours of work every day.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt55__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "CastAI provides a competitive edge to newcomers and independent performers.",
