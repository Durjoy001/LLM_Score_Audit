  "objectives": [
    {
      "text": "CastAI is an AI-powered casting assistant that helps actors and performers find and apply to roles faster.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt55__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "CastAI aims to help actors book more auditions quickly by finding the right roles across major casting platforms.",
      "dimensions": [
        "objectives"
      ],
      "type": "other",
      "primary_dimension": "objectives",
      "meta": {
        "proposal_id": "kt55__openai",
        "chunk_index": 0,
        "char_start": 0,
        "char_end": 1800
      }
    },
    {
      "text": "The funding goal for CastAI was $3,530.",
